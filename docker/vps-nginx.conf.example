# =========================================================================
# Contoh Konfigurasi Nginx di VPS Host (Reverse Proxy ke Docker Container)
# Letakkan di /etc/nginx/sites-available/xlhomejogja (atau conf.d/)
# Lalu buat symlink ke /etc/nginx/sites-enabled/
# =========================================================================

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com; # Ganti dengan domain kamu

    # Redirect semua traffic HTTP ke HTTPS (jika menggunakan SSL)
    # return 301 https://$host$request_uri;

    location / {
        # Proxy ke port container Nginx (sesuaikan dengan APP_PORT di .env, default 8080)
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket support (jika dibutuhkan)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Buffer & Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

# -------------------------------------------------------------------------
# Opsi HTTPS / SSL (Certbot Let's Encrypt):
# Setelah setup di atas, jalankan di VPS:
# sudo certbot --nginx -d example.com -d www.example.com
# -------------------------------------------------------------------------
